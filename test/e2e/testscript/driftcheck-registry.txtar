-- fast-rejected.txt --
The AtlasDriftCheck "fast" is invalid: spec.interval: Invalid value: "string": interval must be at least 1m
-- migration.yaml.tmpl --
apiVersion: db.atlasgo.io/v1alpha1
kind: AtlasMigration
metadata:
  name: target
spec:
  urlFrom:
    secretKeyRef:
      name: db-creds
      key: url
  devURLFrom:
    secretKeyRef:
      name: dev-creds
      key: url
  cloud:
    tokenFrom:
      secretKeyRef:
        name: atlas-token
        key: ATLAS_TOKEN
  dir:
    remote:
      name: atlas-operator-migrations
      tag: ${NAMESPACE}-v1
  policy:
    drift:
      exclude:
        - "*[type=extension]"
        - "public.audit_*"
-- driftcheck.yaml --
apiVersion: db.atlasgo.io/v1alpha1
kind: AtlasDriftCheck
metadata:
  name: check
spec:
  targetRef:
    name: target
  interval: 1m
-- driftcheck-missing.yaml --
apiVersion: db.atlasgo.io/v1alpha1
kind: AtlasDriftCheck
metadata:
  name: missing
spec:
  targetRef:
    name: no-such-migration
-- driftcheck-fast.yaml --
apiVersion: db.atlasgo.io/v1alpha1
kind: AtlasDriftCheck
metadata:
  name: fast
spec:
  targetRef:
    name: target
  interval: 30s
-- patch-fail.yaml --
spec:
  onDrift: Fail
-- patch-suspend.yaml --
spec:
  suspend: true
-- patch-resume.yaml --
spec:
  suspend: false
-- migrations-v1/atlas.sum --
h1:WZ3jz1zWVubQO+J3wTzVYuTegqlIUIBi2+QTk76+M3M=
20250901000000_init.sql h1:MGXyysQDXv89l8J4IuoWGqpsRAwxWpTgBk543swLPkY=
-- migrations-v1/20250901000000_init.sql --
CREATE TABLE users (
  id int NOT NULL,
  name text NOT NULL,
  PRIMARY KEY (id)
);
